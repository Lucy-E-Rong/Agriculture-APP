{
  "expo": {
    "name": "FarmScout",
    "slug": "farmscout",
    "scheme": "farmscout",
    "version": "0.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": ["ios", "android", "web"],
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.farmscout.app"
    },
    "android": {
      "package": "com.farmscout.app"
    },
    "plugins": ["expo-router", "expo-camera", "expo-image-picker"],
    "extra": {
      "apiBaseUrl": "https://agriculture-app-green.vercel.app"
    }
  }
}
